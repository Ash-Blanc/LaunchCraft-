# Copy to backend/.env (never commit the real file).

# PayPal Developer Sandbox — https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only "sandbox" is supported in this build.
PAYPAL_ENV=sandbox

# AI provider (optional). Leave blank to run in clearly labelled demo mode.
AI_API_KEY=
AI_MODEL=

DATABASE_URL=sqlite:///./launchcraft.db
# Where the storefront runs. Also used by the launch check that loads each product page.
FRONTEND_ORIGIN=http://localhost:3000
HTTP_TIMEOUT_SECONDS=15

# --- frontend (set in the shell or frontend/.env.local) ---
# Where Next.js proxies /api requests. No secrets live in the frontend.
BACKEND_URL=http://127.0.0.1:8000
